# AWS配置环境变量示例
# 请根据您的实际配置修改此文件，然后重命名为 .env

# ============================================
# AWS 配置
# ============================================

# AWS访问密钥（如果使用 ~/.aws/credentials 配置文件则不需要）
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS默认区域
AWS_DEFAULT_REGION=us-east-1

# AWS配置文件名称（如果使用多个配置文件）
# AWS_PROFILE=default

# ============================================
# AI 服务配置
# ============================================

# AI服务类型: mock | openai | anthropic
# - mock: 使用内置的模拟AI（不需要API密钥，基于规则分析）
# - openai: 使用OpenAI GPT模型
# - anthropic: 使用Anthropic Claude模型
AI_SERVICE_TYPE=mock

# ============================================
# OpenAI 配置（当 AI_SERVICE_TYPE=openai 时需要）
# ============================================

# OpenAI API密钥
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI模型名称
# OPENAI_MODEL=gpt-4-turbo-preview

# ============================================
# Anthropic 配置（当 AI_SERVICE_TYPE=anthropic 时需要）
# ============================================

# Anthropic API密钥
# ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic模型名称
# ANTHROPIC_MODEL=claude-3-opus-20240229
